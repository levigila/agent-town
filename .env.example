# ============================================================================
# agent-town — configuração
#
# Copie este arquivo para ".env" e preencha as chaves.
#   Copy-Item .env.example .env
#
# O .env NUNCA deve ir para o git (já está no .gitignore) nem para o browser.
# Só o servidor Node lê este arquivo.
# ============================================================================

# --- Verboo -----------------------------------------------------------------
# Cole a chave de https://code.verboo.ai/en/api-keys
VERBOO_API_KEY=
# URL base oficial (code.verboo.ai/en/docs/api). Já é o padrão no código;
# deixe comentada a menos que a Verboo mude o endereço.
# VERBOO_BASE_URL=https://code.verboo.ai/router/v1
# Seu plano permite 2 requisições simultâneas. Não aumente sem checar.
VERBOO_CONCURRENCY=2

# --- Google Gemini ----------------------------------------------------------
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_CONCURRENCY=4

# --- Orquestrador -----------------------------------------------------------
# sim  = roteiro simulado (custo zero, bom para mexer no visual)
# real = chama as APIs de verdade
ORCHESTRATOR=sim

# Modelo de cada papel, no formato provedor:modelo
# Provedores válidos: verboo | gemini
#
# ATENÇÃO: o catálogo depende do seu plano. Rode "npm run doctor" — ele chama
# GET /models com a sua chave e mostra os IDs que VOCÊ pode usar.
# (No plano API pré-pago da Verboo, por exemplo, não existe deepseek-v4-pro.)
PLANNER_MODEL=verboo:deepseek-v4.1-flash
RESEARCHER_MODEL=verboo:glm-5.3-flash
CODER_MODEL=verboo:deepseek-v4.1-flash
# Família diferente do Coder, de propósito: revisão cruzada.
REVIEWER_MODEL=verboo:qwen3.8-27b

# --- Limites de segurança ---------------------------------------------------
# Máximo de passos (chamadas ao modelo) por agente em uma execução.
MAX_STEPS=10
# Máximo de tarefas que o Planner pode criar em um plano.
MAX_TASKS=6
# Teto de gasto estimado em dólar. Ao atingir, a execução para.
# Só funciona se existir pricing.json (veja pricing.example.json).
BUDGET_USD=0.50
# Teto de tokens (entrada + saída) por execução. Este sempre funciona.
MAX_TOKENS=200000
# Tempo máximo de uma execução inteira, em segundos.
TIMEOUT_SEC=600

# --- Modo projeto real ------------------------------------------------------
# Com HOST=127.0.0.1 (padrão), esta variável é IGNORADA: você escolhe
# qualquer pasta na hora, pelo seletor da tela ou digitando o caminho.
#
# Ela só passa a valer se você expor o servidor (HOST=0.0.0.0 ou um IP).
# Nesse caso é OBRIGATÓRIA e funciona como allowlist: sem ela, o modo
# projeto fica desabilitado — senão qualquer um na rede poderia apontar
# os agentes para C:\Windows.
#
# Exemplo Windows: PROJECT_ROOTS=C:\projetos;D:\trabalho
# Exemplo Linux:   PROJECT_ROOTS=/home/user/projetos
# PROJECT_ROOTS=

# --- Servidor ---------------------------------------------------------------
PORT=4173
# 127.0.0.1 = só esta máquina (escolha livre de pastas)
# 0.0.0.0   = exposto na rede (PROJECT_ROOTS obrigatório)
HOST=127.0.0.1
